# Copy to .env.local for local development.

# ---- norai backend ----
# Server-only base URL, including the /v1 prefix. Used by server actions and
# route handlers (e.g. the waitlist signup). Never sent to the browser, so this
# may point at an internal address in production.
NORAI_API_URL=http://localhost:8080/v1

# Browser-visible base URL. Only needed once client components call the API
# directly; such requests must come from an origin listed in the backend's
# CORS_ALLOWED_ORIGINS or they are rejected with a 403 before reaching a handler.
# NEXT_PUBLIC_NORAI_API_URL=http://localhost:8080/v1

# Dashboard screens still read from lib/mock/*. Set to "false" once the
# authenticated dashboard routes are wired to the live API.
NEXT_PUBLIC_NORAI_USE_MOCK=true
