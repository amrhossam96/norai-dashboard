# Copy to .env.local for local development. Defaults match `make up` in the
# norai repo (infra/docker-compose.yml).

# ---- norai stack ----
# The gateway (services/gateway). The dashboard calls it with each project's
# own secret key for config uploads, /v1/recommend and /v1/explain.
NORAI_GATEWAY_URL=http://localhost:8080
# What the onboarding snippets tell customers to point their SDK at.
# NORAI_PUBLIC_GATEWAY_URL=https://api.norai.dev

# Postgres, as the control-plane role (same as the norai CLI). Holds the
# projects, keys, config and catalog, plus the dashboard's own `dashboard.*`
# schema (users, sessions, memberships), created on first use.
NORAI_PG_DSN=postgresql://norai:norai@localhost:5432/norai

# ClickHouse, read-only from here: events, served records, daily metrics.
NORAI_CLICKHOUSE_URL=http://localhost:8123
NORAI_CLICKHOUSE_USER=norai
NORAI_CLICKHOUSE_PASSWORD=norai
NORAI_CLICKHOUSE_DB=norai

# Region stamped on projects created from the dashboard (projects.region).
NORAI_REGION=local

# ---- dashboard ----
# Encrypts the per-project secret key the dashboard holds (dashboard.project_keys).
# Any long random string; changing it orphans existing project keys.
DASHBOARD_SECRET=change-me-to-a-long-random-string
